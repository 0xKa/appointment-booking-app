generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  name         String
  passwordHash String
}

model Booking {
  id         String   @id @default(cuid())
  shopId     String
  providerId String
  time       String
  userId     String
  createdAt  DateTime @default(now())

  @@unique([shopId, providerId, time])
}
